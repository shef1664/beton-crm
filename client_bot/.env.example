# Токен клиентского бота (создать у @BotFather, ОТДЕЛЬНЫЙ от @otdprod_bot)
CLIENT_BOT_TOKEN=

# Адрес backend (по умолчанию production на Render)
BACKEND_URL=https://beton-backend-wr3w.onrender.com

# --- Геокодинг (на стороне backend, не бота) ---
# Провайдер: nominatim (бесплатно, без ключа) или dadata (точнее, нужен токен)
# GEO_PROVIDER=dadata
# DADATA_TOKEN=

# Координаты завода/РБУ (по умолчанию Кемерово, центр)
# PLANT_LAT=55.3550
# PLANT_LON=86.0870
# PLANT_ADDRESS=Кемерово
# MAX_DELIVERY_KM=60
