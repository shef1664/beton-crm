# Токен клиентского бота (создать у @BotFather, ОТДЕЛЬНЫЙ от @otdprod_bot)
CLIENT_BOT_TOKEN=

# Адрес backend (по умолчанию production на Render)
BACKEND_URL=https://beton-backend-wr3w.onrender.com

# Группа отдела продаж: добавьте ЭТОГО бота в группу, дайте право писать,
# и укажите chat_id группы (обычно отрицательное число, напр. -1001234567890).
# Туда падают карточки заявок и запросы «позвать менеджера»; менеджеры отвечают
# клиенту через reply на сообщение бота, «/end» завершает диалог.
SALES_CHAT_ID=

# --- AI-консультант (на стороне backend, не бота) ---
# Настраивается в backend/.env: AI_PROVIDER, AI_MODEL, ANTHROPIC_API_KEY.
# Бот сам ничего к нейросети не отправляет — только зовёт backend /api/ai/chat.

# --- Геокодинг (на стороне backend, не бота) ---
# Провайдер: nominatim (бесплатно, без ключа) или dadata (точнее, нужен токен)
# GEO_PROVIDER=dadata
# DADATA_TOKEN=

# Координаты завода/РБУ (по умолчанию Кемерово, центр)
# PLANT_LAT=55.3550
# PLANT_LON=86.0870
# PLANT_ADDRESS=Кемерово
# MAX_DELIVERY_KM=60
