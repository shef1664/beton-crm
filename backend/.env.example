# amoCRM
AMOCRM_DOMAIN=your-subdomain
AMOCRM_ACCESS_TOKEN=your-long-lived-token
AMOCRM_PIPELINE_ID=10818570
# JSON object with status name -> amoCRM status id
# Example: {"new":123,"qualification":456,"hot_lead":789}
AMOCRM_PIPELINE_STATUSES_JSON=
# JSON object with lead field -> amoCRM custom field id
# Example: {"source_platform":111111,"source_channel":222222,"source_account":333333}
AMOCRM_CUSTOM_FIELD_IDS_JSON=
# JSON object with route bucket -> manager/login/team label
# Example: {"geo":"geo-team","marketplaces":"marketplace-team","messengers":"messenger-team","phone":"call-team","default":"sales-team"}
SALES_MANAGERS_JSON=
# JSON object with integration -> secret key for generic external webhooks
# Example: {"yandex_maps":"secret-1","2gis":"secret-2"}
INTEGRATION_KEYS_JSON=

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_ADMIN_ID=your-telegram-id

# Baserow and local fallback storage
BASEROW_URL=https://api.baserow.io
BASEROW_TOKEN=
BASEROW_LEADS_TABLE_ID=
BASEROW_LOGS_TABLE_ID=
# Optional local SQLite path. Useful when the project lives in Google Drive or another synced/read-only folder.
SQLITE_DB_PATH=

# Backend
API_SECRET_KEY=your-secret-key-change-this
BACKEND_URL=http://localhost:8000
PORT=8000
DEBUG=false

# Voice sales agent
VOICE_ENABLED=true
VOICE_STT_PROVIDER=payload_text
VOICE_TTS_PROVIDER=external_tts
VOICE_FEMALE_VOICE=female-natural-ru
VOICE_AGENT_NAME=Виртуальный менеджер
VOICE_HANDOFF_MESSAGE=Передаю ваш звонок живому менеджеру отдела продаж.

# ── Render (заполнить после деплоя) ──
# RENDER=true
# BACKEND_URL=https://beton-backend-kwa9.onrender.com
# PORT=10000
# Telephony
TELEPHONY_ENABLED=true
TELEPHONY_PROVIDER=telephony
# Optional webhook protection. If set, requests to /webhooks/telephony must include the configured header.
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_AUTH_HEADER=X-Telephony-Secret
TELEPHONY_AUTO_START_VOICE_AGENT=false
# JSON array of accepted webhook event types. Leave empty to use defaults.
# Example: ["incoming_call","call_started","call_finished","missed_call"]
TELEPHONY_ALLOWED_EVENTS_JSON=
# JSON object for line/number routing metadata.
# Example: {"main-line":{"campaign":"main","assigned_manager":"call-team"}}
TELEPHONY_LINE_ROUTING_JSON=
